<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Complaints</title>
  <link rel="stylesheet" href="/css/complaint.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<%- include("../include/navbar") %>
<% if (error && error.length > 0) { %>
  <div class="flash-error">
    <%= error %>
  </div>
<% } %>

<% if (success && success.length > 0) { %>
  <div class="flash-success">
    <%= success %>
  </div>
<% } %>


<div class="complaint-container">

  <h2 class="page-title">📢 Complaints</h2>

  <% if (complaints.length === 0) { %>
    <div class="empty-state" style="text-align: center; padding: 60px 20px; background: #fff; border-radius: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); margin-top: 20px;">
        <i class="fa-regular fa-face-smile" style="font-size: 4rem; color: #cbd5e1; margin-bottom: 20px;"></i>
        <h3 style="color: #475569; font-size: 1.5rem; margin-bottom: 10px;">All Good Here!</h3>
        <p style="color: #94a3b8; max-width: 400px; margin: 0 auto 30px;">There are no active complaints on campus right now. Everything is running smoothly!</p>
        
        <div style="text-align: left; opacity: 0.5; filter: grayscale(100%); pointer-events: none;">
            <p style="text-align:center; font-weight:bold; margin-bottom: 20px; color: #94a3b8;">Demo Complaint Look:</p>
            <div class="complaint-card" style="max-width: 450px; margin: 0 auto; box-shadow: none; border: 1px dashed #cbd5e1;">
                <div class="complaint-header">
                    <h3>Water Cooler Not Working</h3>
                    <span class="status pending">Pending</span>
                </div>
                <p class="complaint-desc">The water cooler on the ground floor of the hostel is dispensing hot water.</p>
                <div class="complaint-footer">
                    <span>👤 Raised by: <b>Admin</b></span>
                    <span>🕒 <%= new Date().toLocaleDateString() %></span>
                </div>
            </div>
        </div>
    </div>
  <% } %>

  <% complaints.forEach(c => { %>
    <div class="complaint-card">

      <div class="complaint-header">
      <h3><%= c.title %></h3>

     <% if (currUser && currUser.role === "admin") { %>

     <form action="/issue/<%= c._id %>/status?_method=PUT"
          method="POST" class="status-form">

      <select name="status" onchange="this.form.submit()"
              class="status-select">

        <option value="Pending" <%= c.status==="Pending"?"selected":"" %>>
          Pending
        </option>

        <option value="InProgress" <%= c.status==="InProgress"?"selected":"" %>>
          In Progress
        </option>

        <option value="Resolved" <%= c.status==="Resolved"?"selected":"" %>>
          Resolved
        </option>

      </select>
     </form>

      <% } else { %>

    <span class="status <%= c.status.toLowerCase() %>">
      <%= c.status %>
    </span>

  <% } %>
 </div>


      <p class="complaint-desc"><%= c.description %></p>

      <div class="complaint-footer">
        <span>
          👤 Raised by:
          <b>
            <%= c.createdBy?.username || "User" %>
          </b>
        </span>

        <span>
          🕒 <%= new Date(c.createdAt).toLocaleDateString("en-IN", {
            day: "2-digit",
            month: "short",
            year: "numeric"
          }) %>
        </span>
      </div>

    </div>
  <% }) %>

</div>

<%- include("../include/footer") %>

</body>
</html>

