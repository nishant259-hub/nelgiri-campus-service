<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Campus Notices</title>
  <link rel="stylesheet" href="/css/notice.css">
  <link rel="stylesheet" href="/css/style.css">
  <script src="https://kit.fontawesome.com/a13f7f6ee4.js" crossorigin="anonymous"></script>
</head>
<body>
  <%- include("../include/navbar") %>

  <div class="container notice-container">
    <h2 class="page-title">Campus Notices</h2>

    <div class="notice-grid">
      <% if (allnotice.length === 0) { %>
        <div class="empty-state" style="grid-column: 1 / -1; text-align: center; padding: 60px 20px; background: #fff; border-radius: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); margin-top: 20px;">
            <i class="fa-regular fa-folder-open" style="font-size: 4rem; color: #cbd5e1; margin-bottom: 20px;"></i>
            <h3 style="color: #475569; font-size: 1.5rem; margin-bottom: 10px;">No Notices Yet</h3>
            <p style="color: #94a3b8; max-width: 400px; margin: 0 auto 30px;">There are currently no official notices or announcements posted by the administration. Check back later!</p>
            
            <div style="text-align: left; opacity: 0.5; filter: grayscale(100%); pointer-events: none;">
                <p style="text-align:center; font-weight:bold; margin-bottom: 20px; color: #94a3b8;">Demo Notice Look:</p>
                <div class="notice-card" style="max-width: 350px; margin: 0 auto; box-shadow: none; border: 1px dashed #cbd5e1;">
                    <div class="notice-content">
                        <h3 class="notice-title">Mid-Semester Exam Schedule</h3>
                        <p class="notice-description">Exams will begin next week. Please carry your ID cards.</p>
                        <p class="notice-meta"><span class="category">Academic</span> | <span><%= new Date().toDateString() %></span></p>
                    </div>
                </div>
            </div>
        </div>
      <% } else { %>
        <% allnotice.forEach(notice => { %>
          <div class="notice-card">
            <% if (notice.imageUrl) { %>
              <img src="<%= notice.imageUrl %>" alt="<%= notice.title %>" class="notice-img">
            <% } %>

            <div class="notice-content">
              <h3 class="notice-title"><%= notice.title %></h3>
              <p class="notice-description"><%= notice.description %></p>
              <p class="notice-meta">
                <span class="category"><%= notice.category %></span> |
                <span class="date"><%= notice.createdAt.toDateString() %></span>
              </p>

              <% if (currUser && currUser.role === "admin") { %>
                <div class="notice-actions">
                  <form action="/notice/<%= notice._id %>?_method=DELETE" method="POST" class="delete-form">
                    <button type="submit" class="btn-delete">
                      <i class="fas fa-trash"></i>
                    </button>
                  </form>
                </div>
              <% } %>

            </div>
          </div>
        <% }) %>
      <% } %>
    </div>

    <% if (showCreateNotice) { %>
      <div class="add-notice-btn">
        <a href="/notice/new" class="btn-add">+ Create New Notice</a>
      </div>
    <% } %>
  </div>

  <%- include("../include/footer") %>
</body>
</html>

